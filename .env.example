# Public Nhost connection values. These are safe to expose in browser code.
NEXT_PUBLIC_NHOST_SUBDOMAIN=your-project-subdomain
NEXT_PUBLIC_NHOST_REGION=eu-central-1

# Optional local/remote URLs when using custom Nhost domains.
# NEXT_PUBLIC_NHOST_AUTH_URL=
# NEXT_PUBLIC_NHOST_GRAPHQL_URL=

# Server-side aliases used by the Next.js server client and middleware.
NHOST_SUBDOMAIN=your-project-subdomain
NHOST_REGION=eu-central-1

# Public application URL used for PKCE OAuth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
